# ============================================================================
# Variables de entorno. Copiar a `.env.local` y completar.
#
# REGLA: solo las que empiezan con NEXT_PUBLIC_ llegan al navegador. Cualquier
# valor secreto va SIN ese prefijo — si se le pone, Next lo incrusta en el
# bundle del cliente y queda público para siempre (ver CLAUDE.md, seguridad).
# `.env.local` está en .gitignore y nunca debe versionarse.
# ============================================================================

# Supabase
# Obtener en: Supabase Dashboard > Project Settings > API Keys
# Este proyecto usa el sistema nuevo de llaves: la pública empieza con
# `sb_publishable_` y la secreta con `sb_secret_` (las antiguas eran JWT `eyJ...`).
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Solo para operaciones de servidor. Pasa por encima de RLS: es el equivalente
# a la llave de superusuario de la base. Nunca exponer al cliente — se importa
# únicamente desde src/lib/supabase/admin.ts, que lleva `import "server-only"`
# para que el build falle si alguien la arrastra a un componente de cliente.
#
# OBLIGATORIA para el formulario de contacto: `contacto_mensajes` no tiene
# política de insert en RLS, así que sin esta llave el formulario valida pero no
# guarda nada (el usuario ve "no se pudo enviar" y el detalle queda en el log).
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Sal para el hash de IP del formulario de contacto (anti-spam).
# El formulario guarda un SHA-256 de (sal + IP), nunca la IP en claro, para
# poder limitar envíos por origen sin almacenar el dato personal. La sal es lo
# que impide revertir el hash por fuerza bruta: el espacio de IPv4 completo se
# tabula en minutos si no hay sal.
# Generar una cadena aleatoria de 32+ caracteres, por ejemplo:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Si se cambia, los contadores de la ventana en curso se reinician (inofensivo).
CONTACT_IP_SALT=

# Google Maps (para el mapa de ubicación de proyectos)
# Al ser NEXT_PUBLIC_ es visible en el navegador — eso es inevitable con la API
# de Maps. La protección es restringir la llave en Google Cloud Console por
# referente HTTP (solo el dominio de producción) y por API habilitada; sin eso,
# cualquiera la copia y consume la cuota de la cuenta.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-key

# App
# Base de los canonical, del sitemap, del robots.txt y de las imágenes de Open
# Graph. Sin barra final.
#
# En producción el dominio es https://topografiaiaca.com y ya está como respaldo
# en src/config/site.ts, así que olvidar esta variable no rompe el SEO. Aun así
# conviene declararla en Vercel: es lo que permite que un despliegue de vista
# previa se apunte a sí mismo en vez de al dominio de producción.
NEXT_PUBLIC_APP_URL=http://localhost:3000
